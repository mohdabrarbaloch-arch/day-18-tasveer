# ─────────────────────────────────────────────────────────────────────────────
# Tasveer — environment variables
#
# Copy to .env and edit. Every value below has a working development default,
# so the app runs with no .env at all. The ones marked REQUIRED IN PRODUCTION
# must be set before you deploy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Shown in the API docs and the health endpoint.
APP_NAME=Tasveer
APP_VERSION=1.0.0

# "development" | "production"
# In production the app adds HSTS and refuses to start with the default secret.
ENVIRONMENT=development

# Verbose error output. Never enable in production.
DEBUG=false

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. The default below is public knowledge — anyone who
# reads this repo can forge a JWT with it. Generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me-in-production

# JWT signing algorithm. HS256 is fine for a single service.
ALGORITHM=HS256

# How long a login lasts, in minutes. 1440 = 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite by default — no server needed, fine for one process.
# For Postgres:
#   DATABASE_URL=postgresql+psycopg://tasveer:tasveer@localhost:5432/tasveer
DATABASE_URL=sqlite:///./tasveer.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# "*" allows any origin — fine for local development, wrong for production.
# Comma-separated list for production:
#   CORS_ORIGINS=https://tasveer.pk,https://www.tasveer.pk
CORS_ORIGINS=*

# ── Rate limiting ────────────────────────────────────────────────────────────
# Format: "<count>/<period>" where period is second|minute|hour|day
RATE_LIMIT_GENERATE=20/minute
RATE_LIMIT_DEFAULT=120/minute

# ── Storage ──────────────────────────────────────────────────────────────────
# Where generated PNGs are written. Must be writable.
# On Vercel this is ephemeral — see the README's deployment caveat.
STORAGE_DIR=./storage/generated

# Where the built UI lives. You should not need to change this.
STATIC_DIR=./static

# Max upload size in MB. Reserved for the image-to-image feature.
MAX_UPLOAD_MB=10

# ── Generation ───────────────────────────────────────────────────────────────
# Credits granted to a new account.
SIGNUP_CREDITS=60

# Images per generation request (Midjourney-style grid).
GRID_SIZE=4

# Hard ceiling on output pixels. Protects against memory exhaustion.
# 4000000 = 4 MP. A 16:9 render at this cap is 1280x720.
MAX_OUTPUT_PIXELS=4000000

# ── Optional remote provider ─────────────────────────────────────────────────
# "local"     — the built-in procedural renderer. No key, no cost, deterministic.
# "openai"    — delegate to OpenAI's image API.
# "replicate" — delegate to a Replicate model.
#
# The API surface does not change. Only the pixels do.
IMAGE_PROVIDER=local

# Only needed when IMAGE_PROVIDER=replicate
REPLICATE_API_TOKEN=

# Only needed when IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
